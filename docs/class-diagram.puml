@startuml class-diagram
title Diagramme de classes - Gestion des notes

class Enseignant {
  - id : Long
  - nom : String
  - prenom : String
  - email : String
  + enseigne(m : Matiere) : boolean
}
class Matiere {
  - id : Long
  - code : String
  - libelle : String
  - semestre : int
  - cloturee : boolean
  + cloturer() : void
}
class Etudiant {
  - id : Long
  - numInscription : String
  - nom : String
  - prenom : String
  - filiere : String
  - niveau : String
}
class Inscription {
  - id : Long
}
class Note {
  - id : Long
  - valeur : BigDecimal
  - dateSaisie : LocalDateTime
  - dateModification : LocalDateTime
  + modifier(v : BigDecimal) : void
}

Enseignant "1..*" -- "0..*" Matiere : enseigne >

' Inscription : un étudiant suivi dans une matière par UN enseignant
Etudiant "1" -- "0..*" Inscription : est inscrit >
Matiere "1" -- "0..*" Inscription : accueille >
Enseignant "1" -- "0..*" Inscription : a en charge >

Matiere "1" -- "0..*" Note : concerne >
Etudiant "1" -- "0..*" Note : obtient >
Enseignant "1" -- "0..*" Note : saisit >

note right of Inscription
  {unique (etudiant, matiere)}
  un étudiant n'a qu'un enseignant
  par matière ; l'enseignant doit
  enseigner cette matière
end note

note right of Note
  {unique (etudiant, matiere)}
  {0 <= valeur <= 20}
  {matiere.cloturee = false}
  avant toute saisie ou modification
  {seul l'enseignant de l'inscription
  saisit / modifie la note}
end note
@enduml
